# zbobr-fs configuration file example (filesystem backends)
# Save this as zbobr-fs.toml in your project root

[dispatcher]
workspaces = "./workspaces"
git_user_name = "zbobr"
git_user_email = "zbobr@example.com"
work_branch_prefix = "zbobr"

# Uncomment to rewrite commit authors after each stage completes
# overwrite_author = true

# Filesystem task backend: tasks stored as YAML files
[tasks]
tasks_dir = "./tasks"

# Filesystem repo backend: clones from local git repos
[repo]
repos_dir = "./repos"
