# zbobr GitHub integration test configuration
# Copy to zbobr_github_test.toml and uncomment the sections you want to test.
# When this file exists at the workspace root, the relevant integration test
# binaries activate GitHub-backed test combinations:
#
#   integration_github_fs  — needs [tasks.github]
#   integration_fs_github  — needs [repo.github]
#   integration_github_github — needs both (always #[ignore], run explicitly)

# Uncomment to enable GitHub task-backend tests (integration_github_fs,
# integration_github_github):
#
# [tasks.github]
# # GitHub repository whose issues are used as the task tracker (owner/repo).
# task_repo = "owner/zbobr-test-tasks"
# # GitHub token with read/write access to the tasks repository.
# token = "ghp_your_task_github_token_here"

# Uncomment to enable GitHub repo-backend tests (integration_fs_github,
# integration_github_github):
#
# [repo.github]
# # GitHub user or organisation where target repos are forked.
# fork_owner = "owner"
# # GitHub token with read/write access to the fork organisation.
# token = "ghp_your_repo_github_token_here"

# Optional: GitHub token passed as GH_TOKEN to agent processes.
# Defaults to "dummy-not-used" which is fine when mcp-tester is the executor.
#
# [dispatcher]
# agent_token = "ghp_your_agent_github_token_here"
