# zbobr GitHub integration test configuration
# Copy to zbobr_github_test.toml and uncomment the sections you want to test.
# When this file exists at the workspace root, the relevant integration test
# binaries activate GitHub-backed test combinations.  All of the generated
# tests are marked `#[ignore]` so they will be skipped by default; run them
# explicitly with `cargo test -- --ignored` once you have filled in credentials:
#
#   integration_github_github — needs both [tasks] and [repo]

# Uncomment to enable GitHub task-backend tests (integration_github_github):
#
# [tasks]
# # GitHub repository whose issues are used as the task tracker (owner/repo).
# github_repo = "owner/zbobr-test-tasks"
# # GitHub token with read/write access to the tasks repository.
# github_token = "ghp_your_task_github_token_here"

# Uncomment to enable GitHub repo-backend tests (integration_github_github):
#
# [repo]
# # GitHub repository to work in, in "owner/repo" format.
# repository = "owner/zbobr-test-repo"
# # Base branch to work against.
# branch = "main"
# # GitHub token with read/write access to the repository.
# github_token = "ghp_your_repo_github_token_here"

# Optional: GitHub token passed as GH_TOKEN to agent processes.
# Defaults to "dummy-not-used" which is fine when mcp-tester is the executor.
#
# [dispatcher]
# agent_token = "ghp_your_agent_github_token_here"
