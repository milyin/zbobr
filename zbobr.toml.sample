# zbobr configuration
# Priority: CLI args > env vars > this file > defaults
#
[dispatcher]

# Workspaces directory; each task gets a separate subdirectory
# workspaces = "./workspaces"

# Backend: "github" or "stub"
# backend = "github"

# CLI tool: "copilot", "claude", or "stub"
# cli_tool = "copilot"
#
# Global AI model used when no stage override is provided.  This value is
# validated against the chosen tool at startup (see `dispatcher.validate()`).
# Defaults to the language-model default (usually `gpt-5-mini`).
# model = "gpt-5-mini"

# Prefix for work branches
# work_branch_prefix = "zbobr_fix"

# Git user name and email for commits made by the tool
# These override any global git config when making commits.
# REQUIRED: Must be set in config, env vars, or global git config.
git_user_name = "Your Name"
git_user_email = "your.email@example.com"

# When enabled, rewrite all commits in the work branch after each stage completes
# to use the configured git_user_name and git_user_email. This is necessary when
# contributing to projects where committer names are verified on CI stages.
# Default: false
# overwrite_author = true

# GitHub token with read-only access for agent processes (passed as GH_TOKEN to agents).
# REQUIRED if agent tokens differ from owner token.
# Prefer ZBOBR_AGENT_GH_TOKEN env var instead of storing here.
# agent_github_token = ""


# Base directory for resolving relative prompt file paths
# prompts_path = "./prompts"

# Stage-specific overrides. Each table lives under the [dispatcher] section,
# e.g. `[dispatcher.preparator]`.  All fields are optional; unspecified values
# fall back to the global defaults (`cli_tool` and the executor-configured
# model) or to an empty prompt list.
#
# [dispatcher.preparator]
# tool = "claude"
# model = "gpt-5"
# prompts = ["preparator.md", "common.md"]
#
# [dispatcher.planner]
# tool = "copilot"
# model = "gpt-5-mini"
# prompts = ["planner.md"]
#
# (other stages work similarly)

[tasks.github]
# Task project repository ("owner/repo") - where tasks are tracked
task_repo = "{{TASK_REPO}}"

# GitHub token for task backend (optional, uses GH_TOKEN or GITHUB_TOKEN env vars by default)
# github_token = ""

[tasks.fs]
# Filesystem task backend: stores tasks as YAML files in a directory
# Uncomment this section to use filesystem backend instead of GitHub
# tasks_dir = "./tasks"

[repo.github]
# GitHub user or org where target repos are forked for implementation
fork_owner = "{{FORK_OWNER}}"

# GitHub token for repo backend (optional, uses GH_TOKEN or GITHUB_TOKEN env vars by default)
# github_token = ""

# GitHub token with read/write access to tasks repo and to the fork organization.
# Priority: GH_TOKEN > GITHUB_TOKEN > this config value.
# Prefer env vars instead of storing in config.
# github_token = ""

[repo.fs]
# Filesystem repo backend: clones from local git repos, stores PRs as YAML files
# Uncomment this section to use filesystem backend instead of GitHub
# repos_dir = "./repos"

[executor.claude]
# Default model for Claude executor (default: "claude-opus-4.6")
# default_model = "claude-opus-4.6"

[executor.copilot]
# Default model for Copilot executor (default: "gpt-5-mini")
# default_model = "gpt-5-mini"

# GitHub token for Copilot CLI with Copilot's access rights (passed as COPILOT_GITHUB_TOKEN).
# Priority: ZBOBR_COPILOT_GITHUB_TOKEN > COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN > $(gh auth token)
# Prefer env vars instead of storing in config.
# copilot_github_token = ""

[executor.mcp_tester]
# YAML scenario files for mcp-tester, one per stage.
# Use with --cli-tool mcp-tester to validate MCP servers.
# planning = "scenarios/planning.yml"
# working = "scenarios/working.yml"
# reviewing = "scenarios/reviewing.yml"
# merging = "scenarios/merging.yml"
